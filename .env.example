# ── Supabase ────────────────────────────────────────────────────────────────
# URL del proyecto y anon key (pública: RLS la protege). Cargar en Netlify también.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SOLO servidor. Jamás exponer con prefijo NEXT_PUBLIC_, jamás commitear.
SUPABASE_SERVICE_ROLE_KEY=

# ── Sitio ───────────────────────────────────────────────────────────────────
# URL canónica de producción (para SEO/sitemap/redirects de auth).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
